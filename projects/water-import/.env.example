# Строка подключения к Postgres (Supabase → Project Settings → Database → Connection string → Session pooler).
# Для локального запуска подойдёт любой Postgres: postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Публичный адрес приложения — нужен для корректных OpenGraph-ссылок и иконок.
# На Vercel задавать не нужно: адрес подставляется автоматически.
SITE_URL="http://localhost:3000"
