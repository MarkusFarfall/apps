# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
# Paste the URI shown by Supabase; do not commit the real password or this file after filling it in.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Public canonical URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Keep small for serverless deployments; defaults to 1.
DB_POOL_MAX=1
